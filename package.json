{
  "name": "project",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch run server.tsx",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bun run server.tsx",
    "generate": "bun ./node_modules/@shogo-ai/sdk/bin/cli.mjs generate",
    "db:generate": "bun x --bun prisma generate",
    "db:migrate:dev": "bun x --bun prisma migrate dev",
    "db:migrate:deploy": "bun x --bun prisma migrate deploy",
    "db:push": "bun x --bun prisma db push",
    "db:reset": "bun x --bun prisma db push --force-reset --accept-data-loss",
    "db:studio": "bun x --bun prisma studio"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@prisma/adapter-libsql": "7.5.0",
    "@prisma/client": "7.5.0",
    "@shogo-ai/sdk": "^2.4.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.12.8",
    "html2canvas": "^1.4.1",
    "lucide-react": "0.563.0",
    "mobx": "6.15.0",
    "mobx-react-lite": "4.1.1",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.4",
    "tailwind-merge": "3.5.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@prisma/internals": "7.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "8.2.2",
    "postcss": "8.5.8",
    "prisma": "7.5.0",
    "shadcn": "3.8.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4"
  }
}
